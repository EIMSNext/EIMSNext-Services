{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning"
            }
        },
        "Enrich": [ "FromLogContext" ],
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
              "Args": {
                "path": "Logs/log-.txt",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 31,
                "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
              }
            }
        ]
    },
    "AllowedHosts": "*",
    "MongoDb": {
        "ConnectionString": "mongodb://127.0.0.1:27017",
        "Database": "EIMS"
    },
    "Storage": {
        //"BaseUrl": "http://localhost:9999/jlupload/api/v1"
        "BaseUrl": "https://localhost:8855/api/v1",
        "LocalPath": ""
    },
    "CacheServer": {
        "EndPoint": "localhost:6379",
        "Database": 6
    },
    "Certificates": {
        "CerPath": "eims.pfx",
        "Password": "123456"
    },
    "OAuth": {
        "BaseUrl": "http://localhost:9999/identity",
        "Authority": "http://localhost:9999/identity",
    },
    "BuiltInClients": {
        "Web": {
            "AllowedOrigins": [
                "https://admin.eimsnext.com",
                "https://mobile.eimsnext.com"
            ],
            "RequireOrigin": true,
            "AllowMissingOriginInDevelopment": true
        },
        "Public": {
            "AllowedOrigins": [],
            "RequireOrigin": false
        }
    },
    "PublicAccess": {
        "SecretKey": "REPLACE_ME_WITH_RANDOM_32_BYTE_SECRET_KEY"
    }
}
