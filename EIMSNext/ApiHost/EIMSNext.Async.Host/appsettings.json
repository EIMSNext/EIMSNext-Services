{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Quartz": "Warning",
                "Microsoft": "Warning",
                "EIMSNext.Async.Core": "Information"
            }
        },
        "Enrich": [ "FromLogContext", "WithProperty" ],
        "Properties": {
            "Application": "EIMSNext.Async.Host"
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-.txt",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 31,
                    "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
                }
            }
        ]
    },
    "ServiceHost": {
        "BaseUrl": "https://service.eimsnext.com"
    },
    "WebHost": {
        "BaseUrl": "https://admin.eimsnext.com"
    },
    "MongoDb": {
        "ConnectionString": "mongodb://localhost:27017",
        "Database": "EIMS"
    },
    "Storage": {
        //"BaseUrl": "http://localhost:9999/jlupload/api/v1"
        "BaseUrl": "http://localhost:9999/JLUpload",
        "LocalPath": "D:\\WebSites\\Upload\\wwwroot"
    },
    "CacheServer": {
        "EndPoint": "localhost:6379",
        "Database": 6
    },
    "IdentityHost": {
        "BaseUrl": "http://localhost:9999/identity",
        "Authority": "http://localhost:9999/identity",
    },
    "FlowApiClient": {
        "BaseUrl": "https://localhost:8877/api/v1"
    },
    "RabbitMQ": {
        "HostName": "localhost",
        "UserName": "guest",
        "Password": "guest"
    },
    "AsyncConsumers": {
        "notify-dispatch": {
            "Concurrency": 2,
            "PrefetchCount": 1
        },
        "system-message": {
            "Concurrency": 5,
            "PrefetchCount": 1
        },
        "email": {
            "Concurrency": 5,
            "PrefetchCount": 1
        },
        "data-export": {
            "Concurrency": 2,
            "PrefetchCount": 1
        },
        "webhook": {
            "Concurrency": 5,
            "PrefetchCount": 1
        }
    },
    "Quartz": {
        "ConnectionString": "mongodb://localhost:27017/Quartz",
        "CollectionPrefix": "quartz",
        "InstanceName": "EIMSNextAsync",
        "InstanceId": "AUTO",
        "MisfireThreshold": "60000",
        "DbRetryInterval": "15000"
    }
}
